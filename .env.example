# Auth0 (Next.js SDK v4) — see ARCHITECTURE.md and BUGLOG.md
# Generate AUTH0_SECRET: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://anzen.api
APP_BASE_URL=http://localhost:3000

# Set to true only after completing Token Vault setup (see ARCHITECTURE.md)
# Leave false or unset for basic sign-in while configuring Auth0.
AUTH0_TOKEN_VAULT_SCOPES=false

# Optional — for scripts/configure-auth0-connections.mjs (Management API, machine-to-machine)
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=

# AI agent — DeepSeek (OpenAI-compatible chat completions).
DEEPSEEK_API_KEY=
# Optional default model (default: deepseek-v4-flash; also: deepseek-v4-pro)
# DEEPSEEK_MODEL=deepseek-v4-flash
# Optional — override the picker list (comma-separated)
# DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Voice input only — Groq Whisper transcription. Optional; mic input is
# disabled when unset.
GROQ_API_KEY=

# Optional — Upstash Redis for per-user settings (permissions, Phase 4+; recommended on Vercel)
# Uses the same vars as Vercel Marketplace / Upstash integration. Falls back to .data/ locally.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional — used by some client-side links
NEXT_PUBLIC_APP_URL=http://localhost:3000
