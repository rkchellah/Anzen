# Auth0 (Next.js SDK v4) — see ARCHITECTURE.md and BUGLOG.md
# Generate AUTH0_SECRET: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://anzen.api
APP_BASE_URL=http://localhost:3000

# Set to true only after completing Token Vault setup (see ARCHITECTURE.md)
# Leave false or unset for basic sign-in while configuring Auth0.
AUTH0_TOKEN_VAULT_SCOPES=false

# Optional — for scripts/configure-auth0-connections.mjs (Management API, machine-to-machine)
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=

# AI models (chat + tools).
# Anzen supports DeepSeek and Groq.
# If both keys are set, Anzen offers both in the model picker and automatically
# falls back to Groq (Llama 3.3 70B) if DeepSeek runs out of credits.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Groq API key: used for Groq chat models (e.g. Llama 3.3 70B), automatic fallback
# when DeepSeek is out of credits, and voice transcription (Groq Whisper).
GROQ_API_KEY=
# AI_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Optional — Upstash Redis for per-user settings (permissions, Phase 4+; recommended on Vercel)
# Uses the same vars as Vercel Marketplace / Upstash integration. Falls back to .data/ locally.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional — used by some client-side links
NEXT_PUBLIC_APP_URL=http://localhost:3000
